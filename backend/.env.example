NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

MONGODB_URI=mongodb://localhost:27017/cracker_shop
# Optional local override when a VPN or DNS proxy makes Node use 127.0.0.1.
# DNS_SERVERS=1.1.1.1,8.8.8.8

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m

# Leave these as "replace_me" in local dev to automatically use local-disk
# image storage fallback instead (see src/uploads/storage.provider.ts)
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

CORS_ORIGINS=http://localhost:4200,http://localhost:4300

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=20

# Only used by `npm run seed:admin` — never commit real values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_locally_only
